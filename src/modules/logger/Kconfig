menuconfig MODULES_LOGGER
	bool "logger"
	default n
	---help---
		Enable support for logger

menuconfig USER_LOGGER
	bool "logger running as userspace module"
	default y
	depends on BOARD_PROTECTED && MODULES_LOGGER
	---help---
		Put logger in userspace memory

menuconfig LOGGER_STACK_SIZE
	int "stack size of logger task"
	default 3700
	depends on MODULES_LOGGER
	---help---
		Stack size of the logger task. Some configurations require more stack
		than the default.

menuconfig LOGGER_WRITER_STACK_SIZE
	int "stack size of the log file writer thread"
	default 1170
	depends on MODULES_LOGGER
	---help---
		Stack size of the log_writer_file thread. File systems with deep call
		chains (e.g. littlefs on NAND) need more than the default.

menuconfig LOGGER_FSYNC_AT_FS_BLOCK_END
	bool "align log fsync to littlefs block ends"
	default n
	depends on MODULES_LOGGER
	---help---
		When the log file is on littlefs, never let a write cross the end of a
		file system block and fsync exactly at the block end, with a 120 s timed
		fallback. On littlefs-on-NAND an fsync in the middle of a block makes the
		next append copy the whole block. Other file systems keep the default
		behaviour (fsync every 1 s or 100 polls). Only used on NuttX and
		ignored when PX4_CRYPTO (encrypted logs) is enabled.
