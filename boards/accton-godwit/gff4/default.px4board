CONFIG_BOARD_TOOLCHAIN="arm-none-eabi"
CONFIG_BOARD_ARCHITECTURE="cortex-m4"
CONFIG_BOARD_CONSTRAINED_FLASH=y
CONFIG_BOARD_NO_HELP=y
CONFIG_BOARD_CONSTRAINED_MEMORY=y
CONFIG_BOARD_EXTERNAL_METADATA=y
CONFIG_BOARD_EMBED_ACTUATORS_METADATA=y
CONFIG_BOARD_PARAM_FILE="/fs/microsd/params"
CONFIG_BOARD_ROOT_PATH="/fs/microsd"
CONFIG_BOARD_SERIAL_GPS1="/dev/ttyS1"
CONFIG_BOARD_SERIAL_TEL1="/dev/ttyS2"
CONFIG_BOARD_SERIAL_TEL2="/dev/ttyS3"
CONFIG_BOARD_SERIAL_RC="/dev/ttyS4"
CONFIG_DRIVERS_ADC_BOARD_ADC=y
CONFIG_DRIVERS_BAROMETER_DPS310=y
CONFIG_DRIVERS_CDCACM_AUTOSTART=y
CONFIG_DRIVERS_DSHOT=y
CONFIG_DRIVERS_GPS=y
CONFIG_DRIVERS_IMU_INVENSENSE_ICM42688P=y
# CONFIG_DRIVERS_MAGNETOMETER_ISENTEK_IST8310 is not set
CONFIG_DRIVERS_OSD_ATXXXX=y
CONFIG_DRIVERS_PWM_OUT=y
CONFIG_DRIVERS_RC_INPUT=y
CONFIG_MODULES_ATTITUDE_ESTIMATOR_Q=y
CONFIG_MODULES_BATTERY_STATUS=y
CONFIG_MODULES_COMMANDER=y
CONFIG_MODULES_CONTROL_ALLOCATOR=y
CONFIG_MODULES_DATAMAN=y
CONFIG_MODULES_EKF2=y
# CONFIG_EKF2_AUX_GLOBAL_POSITION is not set
# CONFIG_EKF2_AUXVEL is not set
# CONFIG_EKF2_BARO_COMPENSATION is not set
# CONFIG_EKF2_DRAG_FUSION is not set
# CONFIG_EKF2_EXTERNAL_VISION is not set
# CONFIG_EKF2_GNSS_YAW is not set
# CONFIG_EKF2_OPTICAL_FLOW is not set
# CONFIG_EKF2_RANGE_FINDER is not set
# CONFIG_EKF2_SIDESLIP is not set
# CONFIG_MODULES_FLIGHT_MODE_MANAGER is not set
CONFIG_MODULES_LAND_DETECTOR=y
CONFIG_MODULES_LOAD_MON=y
CONFIG_MODULES_LOGGER=y
CONFIG_MODULES_MANUAL_CONTROL=y
CONFIG_MODULES_MAVLINK=y
CONFIG_MODULES_MC_ATT_CONTROL=y
# CONFIG_MODULES_MC_HOVER_THRUST_ESTIMATOR is not set
# CONFIG_MODULES_MC_POS_CONTROL is not set
CONFIG_MODULES_MC_RATE_CONTROL=y
# CONFIG_MODULES_NAVIGATOR is not set
CONFIG_MODULES_RC_UPDATE=y
CONFIG_MODULES_SENSORS=y
CONFIG_SYSTEMCMDS_DMESG=y
CONFIG_SYSTEMCMDS_MKLITTLEFS=y
CONFIG_SYSTEMCMDS_MTD=y
CONFIG_SYSTEMCMDS_NSHTERM=y
CONFIG_SYSTEMCMDS_PARAM=y
CONFIG_SYSTEMCMDS_REBOOT=y
CONFIG_SYSTEMCMDS_VER=y
# GFF4 (192 KiB RAM) task stack sizes, tuned 2026-10-06..19 on hardware
CONFIG_WQ_MANAGER_STACKSIZE=1080
CONFIG_MAVLINK_MAIN_STACK_SIZE=2496
CONFIG_MAVLINK_RECEIVER_EXTRA_STACK_SIZE=1300
CONFIG_DATAMAN_STACK_SIZE=2304
CONFIG_NAVIGATOR_STACK_SIZE=2550
# littlefs on NAND: 1170 left 204 B with 23 low-on-stack warnings and hung after ~6.5 min (2026-10-26)
CONFIG_LOGGER_WRITER_STACK_SIZE=1600
# single on-board IST8310 on one I2C bus
CONFIG_SENSORS_VEHICLE_MAGNETOMETER_MAX_COUNT=1
# no perf command on this board; keep only event counters (saves heap)
CONFIG_PERF_COUNT_ONLY=y
# littlefs on NAND: fsync only at file system block ends
CONFIG_LOGGER_FSYNC_AT_FS_BLOCK_END=y
# FPV topic list from src/board_logger_topics.h (the full default list keeps RAM above COM_RAM_MAX)
CONFIG_LOGGER_BOARD_TOPICS=y
